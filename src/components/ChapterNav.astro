---
interface ChapterMeta {
  slug: string;
  name: string;
  sanskrit_name: string;
  number: number;
  status?: string;
}

interface Props {
  chapters: ChapterMeta[];
  currentChapter: number;
}

const { chapters, currentChapter } = Astro.props;

// Only link to active chapters to avoid 404s
const activeChapters = chapters.filter((c) => !c.status || c.status === 'active');
const sortedActive = activeChapters.sort((a, b) => a.number - b.number);
const currentIndex = sortedActive.findIndex((c) => c.number === currentChapter);
const prev = currentIndex > 0 ? sortedActive[currentIndex - 1] : undefined;
const next = currentIndex < sortedActive.length - 1 ? sortedActive[currentIndex + 1] : undefined;
---

<nav aria-label="Chapter navigation" class="max-w-reading mx-auto px-4 py-8 flex flex-wrap sm:flex-nowrap items-center justify-between gap-x-4 gap-y-3 font-ui text-sm border-t border-gold/20 mt-12">
  {prev ? (
    <a
      href={`/chapters/${prev.slug}`}
      class="flex flex-col items-start flex-1 basis-0 min-w-0 py-1 text-left text-saffron-ink hover:underline underline-offset-2 transition-colors"
    >
      <span class="text-xs uppercase tracking-wider text-gray-600">&larr; Previous</span>
      <span class="font-medium">Ch {prev.number}: {prev.name}</span>
    </a>
  ) : (
    <span class="flex-1 basis-0" aria-hidden="true"></span>
  )}

  <a href="/" class="order-last basis-full sm:order-none sm:basis-auto inline-flex items-center justify-center min-h-11 min-w-11 px-2 shrink-0 text-gray-700 hover:text-saffron-ink transition-colors">Home</a>

  {next ? (
    <a
      href={`/chapters/${next.slug}`}
      class="flex flex-col items-end flex-1 basis-0 min-w-0 py-1 text-right text-saffron-ink hover:underline underline-offset-2 transition-colors"
    >
      <span class="text-xs uppercase tracking-wider text-gray-600">Next &rarr;</span>
      <span class="font-medium">Ch {next.number}: {next.name}</span>
    </a>
  ) : (
    <span class="flex-1 basis-0" aria-hidden="true"></span>
  )}
</nav>
