---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gita Kids — Learn the Bhagavad Gita',
  description = 'An illustrated, interactive journey through the Bhagavad Gita for children aged 8-12. Beautiful folk art, word-by-word Sanskrit, and stories that bring ancient wisdom to life.',
} = Astro.props;

// Canonical URL — always the apex gitakids.com (configured as `site`), regardless of
// which domain (www, .org) actually served the request.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Primary navigation, same order on desktop and in the mobile menu.
// `desktop: false` items live only in the mobile menu.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navLinks = [
  { href: '/', label: 'Chapters', desktop: true, match: (p: string) => p === '/' || p.startsWith('/chapters') },
  { href: '/characters', label: 'Characters', desktop: true },
  { href: '/glossary', label: 'Glossary', desktop: true },
  { href: '/pronunciation', label: 'Pronunciation', desktop: true },
  { href: '/dhyanashloka', label: 'Dhyanashloka', desktop: false },
  { href: '/gitamahatmyam', label: 'Gitamahatmyam', desktop: false },
  { href: '/about', label: 'About', desktop: true },
].map((l) => ({ ...l, current: l.match ? l.match(path) : path === l.href }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#FDF6E3" />

    <!-- Favicon (peacock-feather logo) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Native app shell: activates only inside the Capacitor app, never on the website -->
    <script is:inline>
      (function () {
        var C = window.Capacitor;
        if (!C || !(C.isNativePlatform && C.isNativePlatform())) return;
        document.documentElement.classList.add('native-app');
        var P = C.Plugins || {};
        try {
          if (P.StatusBar) {
            P.StatusBar.setOverlaysWebView({ overlay: true }); // edge-to-edge: content under the status bar
            // 'DARK' = a dark bar background, so the OS draws LIGHT (white) icons —
            // which sit on the indigo safe-area band painted by the CSS below.
            P.StatusBar.setStyle({ style: 'DARK' });
          }
        } catch (e) {}
        function onReady(fn) {
          if (document.readyState !== 'loading') fn();
          else document.addEventListener('DOMContentLoaded', fn);
        }
        onReady(function () { try { if (P.SplashScreen) P.SplashScreen.hide(); } catch (e) {} });
        try {
          if (P.App) {
            P.App.addListener('backButton', function () {
              if (window.history.length > 1) window.history.back();
              else P.App.exitApp();
            });
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* Native-app feel — scoped to the Capacitor app only (html.native-app) */
      html.native-app, html.native-app body { overscroll-behavior: none; }
      html.native-app {
        -webkit-user-select: none; user-select: none;
        -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
      }
      /* Keep content clear of the overlaid status bar and the gesture/nav bar */
      html.native-app #site-nav { padding-top: calc(1rem + env(safe-area-inset-top)); }
      html.native-app body { padding-bottom: env(safe-area-inset-bottom); }
      /* Paint the system-bar zones with solid brand indigo so the OS chrome reads as a
         distinct frame around the cream content. White status/nav icons sit on indigo
         at high contrast — matches the native theme colour for a flash-free cold start. */
      html.native-app::before { content: ""; position: fixed; top: 0; left: 0; right: 0;
        height: env(safe-area-inset-top); background: #2D3A87; z-index: 9998; pointer-events: none; }
      html.native-app::after { content: ""; position: fixed; bottom: 0; left: 0; right: 0;
        height: env(safe-area-inset-bottom); background: #2D3A87; z-index: 9998; pointer-events: none; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-cream">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-saffron-ink focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-ui focus:text-sm">
      Skip to content
    </a>
    <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-saffron z-[100] transition-[width] duration-100 ease-out" style="width: 0%"></div>
    <!-- Navigation -->
    <nav id="site-nav" class="bg-cream sticky top-0 z-50 pt-4 pb-4 transition-shadow duration-300">
      <div class="max-w-reading lg:max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-2 sm:gap-6">
        <a href="/" class="flex items-center gap-1.5 sm:gap-2 group shrink-0">
          <span lang="sa" class="font-devanagari text-[1.7rem] text-saffron group-hover:text-saffron/80 transition-colors leading-none">गीता</span>
          <span class="font-devanagari text-gold/40 text-lg leading-none">&#x2022;</span>
          <span class="font-ui text-sm font-semibold text-gray-600 tracking-wide uppercase">Kids</span>
        </a>
        <!-- Desktop search bar -->
        <form role="search" class="hidden lg:block flex-1 min-w-0 max-w-sm" onsubmit="return false">
          <label class="relative block">
            <span class="sr-only">Search all verses</span>
            <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5" />
            </svg>
            <input
              id="search-input-desktop"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search all verses"
              role="combobox"
              aria-controls="search-results"
              aria-expanded="false"
              aria-autocomplete="list"
              class="w-full rounded-full border border-gold/30 bg-white/70 py-2 pl-9 pr-9 font-ui text-sm text-gray-800 placeholder:text-gray-400 focus:border-saffron/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-saffron/20"
            />
            <kbd class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded border border-gold/30 px-1.5 font-ui text-xs text-gray-500">/</kbd>
          </label>
        </form>
        <div class="flex items-center gap-1 lg:gap-5 font-ui text-sm">
          {navLinks.filter((l) => l.desktop).map((l) => (
            <a
              href={l.href}
              aria-current={l.current ? 'page' : undefined}
              class:list={[
                'hidden lg:inline-block py-2 transition-colors hover:text-saffron-ink',
                l.current ? 'text-saffron-ink font-semibold' : 'text-gray-600',
              ]}
            >{l.label}</a>
          ))}
          <!-- Search button (below lg, where the bar is hidden) -->
          <button
            id="search-toggle"
            class="lg:hidden inline-flex items-center justify-center min-w-11 min-h-11 text-gray-600 hover:text-saffron-ink transition-colors"
            aria-label="Search all verses"
            aria-controls="mobile-search"
            aria-expanded="false"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5" />
            </svg>
          </button>
          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden inline-flex items-center justify-center min-w-11 min-h-11 -mr-2 text-gray-600 hover:text-saffron-ink transition-colors"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
      <!-- Search row (below lg) -->
      <div id="mobile-search" class="hidden lg:hidden">
        <form role="search" class="max-w-reading mx-auto px-6 pt-3" onsubmit="return false">
          <label class="relative block">
            <span class="sr-only">Search all verses</span>
            <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5" />
            </svg>
            <input
              id="search-input-mobile"
              type="search"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="Search all verses"
              role="combobox"
              aria-controls="search-results"
              aria-expanded="false"
              aria-autocomplete="list"
              class="w-full rounded-full border border-gold/30 bg-white/70 py-2.5 pl-9 pr-4 font-ui text-base text-gray-800 placeholder:text-gray-400 focus:border-saffron/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-saffron/20"
            />
          </label>
        </form>
      </div>
      <!-- Search results (shared by both inputs) -->
      <div id="search-panel" class="hidden absolute left-0 right-0 top-full px-3 sm:px-6 pt-2">
        <div class="max-w-2xl mx-auto overflow-hidden rounded-2xl border border-gold/25 bg-cream shadow-xl shadow-black/10">
          <p id="search-status" class="px-4 py-2 font-ui text-xs text-gray-500 border-b border-gold/15" role="status" aria-live="polite"></p>
          <div id="search-results" role="listbox" aria-label="Search results" class="max-h-[calc(100dvh-11rem)] overflow-y-auto overscroll-contain"></div>
        </div>
      </div>
      <!-- Mobile dropdown menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-gold/20 bg-cream">
        <div class="max-w-reading mx-auto px-6 py-1 flex flex-col font-ui">
          {navLinks.map((l) => (
            <a
              href={l.href}
              aria-current={l.current ? 'page' : undefined}
              class:list={[
                'block py-3 border-b border-gold/10 last:border-b-0 text-base transition-colors hover:text-saffron-ink',
                l.current ? 'text-saffron-ink font-semibold' : 'text-gray-700',
              ]}
            >{l.label}</a>
          ))}
        </div>
      </div>
      <!-- Gold gradient bottom border -->
      <div class="h-[2px] bg-gradient-to-r from-gold/10 via-gold/40 to-gold/10 mt-auto"></div>
    </nav>

    <!-- Breadcrumb slot area -->
    <slot name="breadcrumb" />

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gold/20 py-8 mt-16">
      <div class="max-w-reading mx-auto px-6 text-center font-ui text-sm text-gray-600">
        <p lang="sa" class="font-devanagari text-lg text-saffron-ink mb-2">श्रीमद्भगवद्गीता</p>
        <p>Gita Kids &mdash; Ancient wisdom, young hearts</p>
      </div>
    </footer>
    <script>
      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.scroll-reveal').forEach((el) => observer.observe(el));
      }

      function initProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        function update() {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = docHeight > 0 ? `${(scrollTop / docHeight) * 100}%` : '0%';
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      function initNavScroll() {
        const nav = document.getElementById('site-nav');
        if (!nav) return;
        let ticking = false;
        function update() {
          // Height stays fixed (a sticky, in-flow nav that shrinks shifts the page);
          // only the shadow changes once the page scrolls.
          nav.style.boxShadow = window.scrollY > 8 ? '0 1px 8px rgba(0,0,0,0.06)' : 'none';
          ticking = false;
        }
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
        update();
      }

      function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');
        });
      }

      initScrollReveal();
      initProgress();
      initNavScroll();
      initMobileMenu();
    </script>
    <script>
      import { initSearch, highlightFromQuery } from '../scripts/search';
      initSearch();
      highlightFromQuery();
    </script>
  </body>
</html>
